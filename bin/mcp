#!/usr/bin/env bash
# mcp <master|agent>: the command .mcp.json runs for each knowledge MCP server. Sources the env,
# brings the store up (a longer bounded wait, since it is about to connect), then execs the same
# docker run of the Postgres MCP server .mcp.json used to run inline -- but the DATABASE_URI, with
# its password, is built here from the env and passed only as a process variable, so no config
# file ever holds the password.
# The database is unreachable only during a first-ever cold start; the MCP server is started by the
# client and will surface as failed until the store finishes coming up (a later /mcp reconnect, or
# the next session, attaches it). See the README troubleshooting section.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../hooks/lib.sh
source "$ROOT/hooks/lib.sh"

role="${1:-}"
load_env
case "$role" in
  master) user=master ;;
  agent)  user=agent ;;
  *) echo "mcp: role must be master or agent" >&2; exit 2 ;;
esac

# About to connect: give a cold start up to 30s, but still fail open and exec regardless. On a
# first-ever cold start, ensure_up is what writes the password file, so the password for the URI
# below must be read AFTER this call returns, not before -- read it too early and it is empty.
KNOWLEDGE_WAIT_SECS="${KNOWLEDGE_WAIT_SECS:-30}" ensure_up || true

case "$role" in
  master) pw="${KNOWLEDGE_MASTER_PASSWORD:-}" ;;
  agent)  pw="${KNOWLEDGE_AGENT_PASSWORD:-}" ;;
esac

container="$(knowledge_container)"
network="${KNOWLEDGE_NETWORK:-knowledge}"
image="${KNOWLEDGE_MCP_IMAGE:-crystaldba/postgres-mcp}"
owner="$PPID"
name="knowledge-mcp-${role}-${owner}"

# Reap orphans: a session that ends without the docker client seeing the exit leaves its sidecar
# running. Only containers labelled knowledge.owner are ever touched; the reap fails open.
{
  for c in $(docker ps -aq --filter "label=knowledge.owner"); do
    pid="$(docker inspect -f '{{index .Config.Labels "knowledge.owner"}}' "$c" 2>/dev/null || true)"
    [ -n "$pid" ] && ! ps -p "$pid" >/dev/null 2>&1 && docker rm -f "$c" >/dev/null 2>&1
  done
} || true

export DATABASE_URI="postgresql://${user}:${pw}@${container}:5432/knowledge"
exec docker run -i --rm --network "$network" --name "$name" --label "knowledge.owner=$owner" \
  -e DATABASE_URI "$image" --access-mode=unrestricted
