#!/usr/bin/env bash
# knowledge-up [--dump|--restore <file>|--down]: manages the knowledge store container.
# Plain run: creates the private network when missing, then the container with the named volume at
# the image's data mount point (/var/lib/postgresql), restart policy unless-stopped, db/init
# mounted read-only, no host port unless KNOWLEDGE_PORT is set. A present-but-stopped container is
# started instead of a no-op. Exits 1 naming the first unset password variable.
# --dump: pg_dump -U postgres -Fc knowledge through docker exec into KNOWLEDGE_DUMP_DIR
# (default $HOME/.knowledge/dumps), named knowledge-<YYYYMMDD-HHMM>.dump, then prunes old dumps
# (keeps the newest 14 and the first dump of every month).
# --restore <file>: pg_restore through docker exec -i, from the given dump file.
# --down: stop and remove the container; the volume is kept.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../hooks/lib.sh
source "$ROOT/hooks/lib.sh"

CONTAINER="$(knowledge_container)"
VOLUME="${KNOWLEDGE_VOLUME:-knowledge_data}"
NETWORK="${KNOWLEDGE_NETWORK:-knowledge}"
DUMP_DIR="${KNOWLEDGE_DUMP_DIR:-$HOME/.knowledge/dumps}"
IMAGE="${KNOWLEDGE_IMAGE:-postgres:18}"
MCP_IMAGE="${KNOWLEDGE_MCP_IMAGE:-crystaldba/postgres-mcp}"

require_passwords() {
  local v
  for v in POSTGRES_PASSWORD KNOWLEDGE_MASTER_PASSWORD KNOWLEDGE_AGENT_PASSWORD; do
    if [ -z "${!v:-}" ]; then
      echo "knowledge-up: $v is not set" >&2
      exit 1
    fi
  done
}

ensure_network() {
  docker network inspect "$NETWORK" >/dev/null 2>&1 || docker network create "$NETWORK" >/dev/null
}

container_running() {
  [ "$(docker container inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = "true" ]
}

up() {
  if docker container inspect "$CONTAINER" >/dev/null 2>&1; then
    if container_running; then
      echo "knowledge-up: container $CONTAINER already running"
    else
      docker start "$CONTAINER" >/dev/null
      echo "knowledge-up: started existing container $CONTAINER"
    fi
    exit 0
  fi
  load_env
  require_passwords
  ensure_network
  local port_args=()
  if [ -n "${KNOWLEDGE_PORT:-}" ]; then
    port_args=(-p "127.0.0.1:${KNOWLEDGE_PORT}:5432")
  fi
  docker run -d --name "$CONTAINER" \
    --network "$NETWORK" \
    --restart unless-stopped \
    -e POSTGRES_PASSWORD \
    -e POSTGRES_DB=knowledge \
    -e KNOWLEDGE_MASTER_PASSWORD \
    -e KNOWLEDGE_AGENT_PASSWORD \
    -v "${VOLUME}:/var/lib/postgresql" \
    -v "$ROOT/db/init:/docker-entrypoint-initdb.d:ro" \
    ${port_args[@]+"${port_args[@]}"} \
    "$IMAGE" >/dev/null
  echo "knowledge-up: started $CONTAINER"
}

# prune_dumps: keep the newest 14 dumps and the first (earliest) dump of every calendar month;
# delete the rest. Names sort chronologically (knowledge-YYYYMMDD-HHMM.dump).
prune_dumps() {
  [ -d "$DUMP_DIR" ] || return 0
  local -a all=()
  shopt -s nullglob
  local f
  for f in "$DUMP_DIR"/knowledge-*.dump; do all+=("$(basename "$f")"); done
  shopt -u nullglob
  [ "${#all[@]}" -gt 0 ] || return 0

  local sorted keepfile base
  sorted="$(printf '%s\n' "${all[@]}" | LC_ALL=C sort)"
  keepfile="$(mktemp)"
  printf '%s\n' "$sorted" | tail -n 14 >> "$keepfile"
  printf '%s\n' "$sorted" | awk -F'[-.]' '{ ym = substr($2,1,6); if (!(ym in seen)) { seen[ym]=1; print $0 } }' >> "$keepfile"

  shopt -s nullglob
  for f in "$DUMP_DIR"/knowledge-*.dump; do
    base="$(basename "$f")"
    grep -qxF "$base" "$keepfile" || rm -f "$f"
  done
  shopt -u nullglob
  rm -f "$keepfile"
}

dump() {
  mkdir -p "$DUMP_DIR"
  local file="$DUMP_DIR/knowledge-$(date +%Y%m%d-%H%M).dump"
  docker exec "$CONTAINER" pg_dump -U postgres -Fc knowledge > "$file"
  echo "knowledge-up: dumped to $file"
  prune_dumps
}

restore() {
  local file="$1"
  [ -n "$file" ] || { echo "knowledge-up: --restore needs a file" >&2; exit 1; }
  docker exec -i "$CONTAINER" pg_restore -U postgres -d knowledge --clean --if-exists < "$file"
  echo "knowledge-up: restored from $file"
}

down() {
  if ! docker container inspect "$CONTAINER" >/dev/null 2>&1; then
    echo "knowledge-up: container $CONTAINER is not present; volume $VOLUME kept"
    return 0
  fi
  docker stop "$CONTAINER" >/dev/null 2>&1 || true
  docker rm "$CONTAINER" >/dev/null 2>&1 || true
  echo "knowledge-up: removed container $CONTAINER; volume $VOLUME kept"
}

case "${1:-}" in
  --dump) dump ;;
  --restore) restore "${2:-}" ;;
  --down) down ;;
  "") up ;;
  *) echo "knowledge-up: unknown argument $1" >&2; exit 1 ;;
esac
