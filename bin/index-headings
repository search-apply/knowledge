#!/usr/bin/env bash
# index-headings <project> <path>...: indexes every markdown heading (`^#{1,4} `) under the
# given paths as a `section` row in the knowledge store (knowledge.put through hooks/lib.sh's
# psql_as master). A heading whose current row already holds the same text and fields is
# skipped, not re-put, so unchanged keys keep their ids; a current row of an indexed file whose
# heading is gone is superseded by a row reading `removed`. All puts of one run go through one
# psql_as master call, in one transaction. --dry-run prints the generated SQL and writes
# nothing. --self-test covers the slug, the line range and the first-line pick on a fixture.
# See skills/knowledge/SKILL.md ("Indexing") and db/tests/hooks/index-headings.sh.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../hooks/lib.sh
source "$ROOT/hooks/lib.sh"

sql_quote() { printf '%s' "$1" | sed "s/'/''/g"; }

slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# relpath <abs-target> <abs-base>: <abs-target> written relative to <abs-base>.
relpath() {
  local target="$1" base="$2" i=0 up rel=""
  local -a t b
  IFS='/' read -r -a t <<< "$target"
  IFS='/' read -r -a b <<< "$base"
  while [ "$i" -lt "${#t[@]}" ] && [ "$i" -lt "${#b[@]}" ] && [ "${t[$i]}" = "${b[$i]}" ]; do
    i=$((i + 1))
  done
  up=$(( ${#b[@]} - i ))
  for ((k = 0; k < up; k++)); do rel+="../"; done
  for ((k = i; k < ${#t[@]}; k++)); do rel+="${t[$k]}/"; done
  printf '%s' "${rel%/}"
}

# parse_headings <file>: one line per heading, tab-separated
#   <first-line>\t<last-line>\t<heading text>\t<summary, cut at 200 chars>
parse_headings() {
  awk '
    /^#{1,4} / {
      n++
      level[n] = length($1)
      line[n] = NR
      sub(/^#{1,4}[ \t]+/, "")
      text[n] = $0
      next
    }
    { body[NR] = $0 }
    END {
      total = NR
      for (i = 1; i <= n; i++) {
        last = total
        for (j = i + 1; j <= n; j++) {
          if (level[j] <= level[i]) { last = line[j] - 1; break }
        }
        summary = ""
        for (k = line[i] + 1; k <= last; k++) {
          s = body[k]
          gsub(/^[ \t]+|[ \t]+$/, "", s)
          if (s != "") { summary = s; break }
        }
        if (length(summary) > 200) summary = substr(summary, 1, 200)
        printf "%d\t%d\t%s\t%s\n", line[i], last, text[i], summary
      }
    }
  ' "$1"
}

self_test() {
  local tmp fails=0
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  cat > "$tmp/a.md" <<'EOF'
# Heading One!

First content line.

## Heading Two
Second line here, long enough to check cutting is not triggered.
EOF
  check() { local name="$1" exp="$2" got="$3"
    if [ "$exp" = "$got" ]; then echo "PASS $name"; else echo "FAIL $name: want '$exp' got '$got'"; fails=$((fails + 1)); fi
  }
  check slug "heading-one" "$(slug "Heading One!")"
  check slug-trim "a-b" "$(slug "  A -- b  ")"

  local rows row f1 l1 h1 s1 f2 l2 h2 s2
  rows="$(parse_headings "$tmp/a.md")"
  row="$(printf '%s\n' "$rows" | sed -n 1p)"; IFS=$'\t' read -r f1 l1 h1 s1 <<< "$row"
  row="$(printf '%s\n' "$rows" | sed -n 2p)"; IFS=$'\t' read -r f2 l2 h2 s2 <<< "$row"
  check heading1-line "1" "$f1"
  check heading1-last "6" "$l1"
  check heading1-text "Heading One!" "$h1"
  check heading1-summary "First content line." "$s1"
  check heading2-line "5" "$f2"
  check heading2-last "6" "$l2"
  check heading2-text "Heading Two" "$h2"
  check heading2-summary "Second line here, long enough to check cutting is not triggered." "$s2"

  local long summary_long
  printf '# H\n\n%s\n' "$(head -c 260 < /dev/zero | tr '\0' 'x')" > "$tmp/b.md"
  summary_long="$(printf '%s\n' "$(parse_headings "$tmp/b.md")" | cut -f4)"
  check summary-cut-200 "200" "${#summary_long}"

  [ "$fails" -eq 0 ]
}

main() {
  if [ "${1:-}" = "--self-test" ]; then self_test; exit $?; fi

  local dry_run=0
  if [ "${1:-}" = "--dry-run" ]; then dry_run=1; shift; fi
  local project="${1:-}"; shift || true
  if [ -z "$project" ] || [ "$#" -eq 0 ]; then
    echo "usage: index-headings [--dry-run] <project> <path>..." >&2
    exit 2
  fi

  local base_dir="$PWD"
  local -a files=()
  while IFS= read -r f; do [ -n "$f" ] && files+=("$f"); done < <(for p in "$@"; do find "$p" -type f -name '*.md'; done | sort -u)

  # read: the current section rows for this project, as one JSON array.
  local current_json
  current_json="$(psql_as master -c "select coalesce(jsonb_agg(jsonb_build_object('key', key, 'text', text, 'fields', fields)), '[]'::jsonb)::text from knowledge.current where project = '$(sql_quote "$project")' and kind = 'section'")"

  local sql="begin;"$'\n'
  local headings=0 retired=0
  local -a new_keys=()

  for f in "${files[@]:-}"; do
    local abs relfile
    abs="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
    relfile="$(relpath "$abs" "$base_dir")"

    local -a file_keys=()
    local rows
    rows="$(parse_headings "$f")"
    [ -z "$rows" ] && continue

    while IFS=$'\t' read -r first last heading summary; do
      [ -z "${first:-}" ] && continue
      headings=$((headings + 1))
      local key hslug text_new fields_new cur_text cur_fields
      hslug="$(slug "$heading")"
      key="${relfile}#${hslug}"
      file_keys+=("$key")
      new_keys+=("$key")
      text_new="${heading}"$'\n'"${summary}"
      fields_new="$(jq -Snc --arg file "$relfile" --arg heading "$heading" --arg lines "${first}-${last}" --arg summary "$summary" '{file:$file,heading:$heading,lines:$lines,summary:$summary}')"

      cur_text="$(jq -r --arg k "$key" '.[] | select(.key == $k) | .text' <<< "$current_json")"
      cur_fields="$(jq -Sc --arg k "$key" '.[] | select(.key == $k) | .fields' <<< "$current_json")"
      if [ "$cur_text" = "$text_new" ] && [ "$cur_fields" = "$fields_new" ]; then
        continue
      fi

      sql+="select knowledge.put('$(sql_quote "$project")', 'section', '$(sql_quote "$key")', '$(sql_quote "$text_new")', '$(sql_quote "$fields_new")'::jsonb, null, null, '$(sql_quote "${relfile}:${first}")', 'master', '{index}');"$'\n'
    done <<< "$rows"

    # retire: current rows of this file no longer produced, and not already removed.
    local -a old_keys=()
    while IFS= read -r k; do [ -n "$k" ] && old_keys+=("$k"); done < <(jq -r --arg p "${relfile}#" '.[] | select(.key | startswith($p)) | .key' <<< "$current_json")
    for ok in "${old_keys[@]:-}"; do
      [ -z "$ok" ] && continue
      local still=0
      for nk in "${file_keys[@]:-}"; do [ "$nk" = "$ok" ] && still=1 && break; done
      [ "$still" -eq 1 ] && continue
      local ot
      ot="$(jq -r --arg k "$ok" '.[] | select(.key == $k) | .text' <<< "$current_json")"
      [ "$ot" = "removed" ] && continue
      local of
      of="$(jq -c --arg k "$ok" '.[] | select(.key == $k) | .fields' <<< "$current_json")"
      retired=$((retired + 1))
      sql+="select knowledge.put('$(sql_quote "$project")', 'section', '$(sql_quote "$ok")', 'removed', '$(sql_quote "$of")'::jsonb, null, null, null, 'master', '{index}');"$'\n'
    done
  done
  sql+="commit;"$'\n'

  if [ "$dry_run" -eq 1 ]; then
    printf '%s' "$sql"
  elif [ "$headings" -gt 0 ] || [ "$retired" -gt 0 ]; then
    printf '%s' "$sql" | psql_as master >/dev/null
  fi

  echo "indexed ${#files[@]} files, ${headings} headings, ${retired} retired"
}

main "$@"
